# Copy to .env and edit for this workstation.
ISAAC_SIM_ROOT=C:\isaac-sim\_build\windows-x86_64\release
ROVER_SCENE=scenes/CAMERASYNCSSMOETIMES_LOCAL_JACKAL_CANDIDATE.usd
WSL_DISTRO=Ubuntu
ROS_DOMAIN_ID=0
ROS_CONTAINER=aiaa_rover_dev
ROS_WORKSPACE=/workspace
# Optional preferred Tailscale hostname/IP for a PC hosting remote USB devices.
# If blank, the launcher discovers online Tailscale peers sharing USB/IP devices.
ROVER_REMOTE_USB_HOST=
# Optional preferred remote USB bus IDs. If blank or stale, the launcher prompts
# and saves the selected IDs in this computer's ignored .env file.
ROVER_REMOTE_USB_BUSIDS=
# WSL Ubuntu input group ID; check with `getent group input` if different.
INPUT_GID=995
